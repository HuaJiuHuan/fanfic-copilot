# DeepSeek API 密钥（必填，AI 生成/对话依赖）
DEEPSEEK_API_KEY=sk-your-deepseek-api-key

# Turso 数据库（必填，SQLite 云数据库）
TURSO_DATABASE_URL=libsql://your-database.turso.io
TURSO_AUTH_TOKEN=your-turso-auth-token

# NextAuth.js 加密密钥（必填，用于 session 加密，可运行 openssl rand -hex 32 生成）
AUTH_SECRET=your-64-char-random-hex-string
